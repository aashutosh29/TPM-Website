---
import {
  footerAbout,
  footerAccommodation,
  footerQuickLinks,
  site,
  socialLinks,
} from '../data/site';
---

<footer class="relative mt-auto overflow-hidden border-t border-black/10 bg-tpm-green-dark text-white">
  <img
    src="https://tivertonparkmanor.com/wp-content/uploads/2025/04/banner-footer.png"
    alt=""
    class="pointer-events-none absolute -left-10 bottom-0 w-56 opacity-20"
    loading="lazy"
  />
  <div class="eldcare-section relative grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <h6 class="text-sm font-semibold uppercase tracking-wide text-white/90">About us</h6>
      <ul class="mt-3 space-y-2 text-sm text-white/80">
        {footerAbout.map((l) => (
          <li>
            <a href={l.href} class="hover:text-white">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h6 class="text-sm font-semibold uppercase tracking-wide text-white/90">Accommodation</h6>
      <ul class="mt-3 space-y-2 text-sm text-white/80">
        {footerAccommodation.map((l) => (
          <li>
            <a href={l.href} class="hover:text-white">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h6 class="text-sm font-semibold uppercase tracking-wide text-white/90">Quick Links</h6>
      <ul class="mt-3 space-y-2 text-sm text-white/80">
        {footerQuickLinks.map((l) => (
          <li>
            <a href={l.href} class="hover:text-white">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="space-y-4 text-sm">
      <div>
        <h4 class="text-lg font-semibold">Contact us for inquiries.</h4>
        <p class="mt-1">
          <a href={`tel:${site.phoneTel}`} class="hover:underline">{site.phone}</a>
        </p>
      </div>
      <div>
        <h4 class="font-semibold">Email us</h4>
        <a href={`mailto:${site.email}`} class="text-white/85 hover:underline">{site.email}</a>
      </div>
      <div>
        <h4 class="font-semibold">Visit us</h4>
        <p class="text-white/85">{site.address.formatted}</p>
      </div>
      <div class="flex gap-4 text-xs uppercase tracking-wider text-white/70">
        {socialLinks.map((s) => (
          <a href={s.href} class="hover:text-white">{s.label}</a>
        ))}
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 px-4 py-4 text-center text-xs text-white/60">
    © {new Date().getFullYear()} {site.name}
  </div>
</footer>