---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/live/PageHero.astro';
import { faqsPage } from '../data/pages/faqs-page';
---

<BaseLayout title={faqsPage.metaTitle}>
  <PageHero title={faqsPage.h1} breadcrumb="FAQs Page" />
  <section class="eldcare-section max-w-3xl">
    <p class="text-sm font-semibold uppercase text-tpm-muted">{faqsPage.eyebrow}</p>
    <h2 class="mt-2 text-3xl font-bold">{faqsPage.heading}</h2>
    <div class="mt-8 space-y-4">
      {faqsPage.items.map((item, i) => (
        <details class="rounded-xl border border-black/10 bg-white p-5" open={i === 0}>
          <summary class="cursor-pointer font-semibold text-tpm-ink">{item.q}</summary>
          <p class="mt-3 text-sm text-tpm-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>