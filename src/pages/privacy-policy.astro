---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/live/PageHero.astro';
import { privacyPolicyPage } from '../data/pages/privacy-policy';
---

<BaseLayout title={privacyPolicyPage.metaTitle} description={privacyPolicyPage.description}>
  <PageHero title={privacyPolicyPage.h1} />
  <section class="eldcare-section max-w-3xl">
    <p class="text-sm text-tpm-muted">Effective {privacyPolicyPage.effective}</p>
  </section>
  <section class="eldcare-section max-w-3xl space-y-10 pb-16">
    {
      privacyPolicyPage.sections.map((section) => (
        <article>
          <h2 class="text-xl font-bold text-tpm-ink">{section.title}</h2>
          <p class="mt-3 text-tpm-muted">{section.body}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>