---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/live/PageHero.astro';
import { lifestylePage } from '../data/pages/lifestyle';
---

<BaseLayout title={lifestylePage.metaTitle} description={lifestylePage.description}>
  <PageHero title={lifestylePage.h1} />
  <section class="eldcare-section text-center">
    <p class="text-sm font-semibold uppercase text-tpm-muted">{lifestylePage.journey}</p>
    <h2 class="mt-2 text-3xl font-bold">{lifestylePage.sub}</h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {lifestylePage.highlights.map((h) => (
        <article class="eldcare-feature-card text-left">
          <h3 class="text-lg font-semibold text-tpm-green">{h.title}</h3>
          <p class="mt-2 text-sm text-tpm-muted">{h.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-black/10 bg-white">
    <div class="eldcare-section max-w-3xl">
      <h2 class="text-2xl font-bold">{lifestylePage.sectionOne.title}</h2>
      <p class="mt-4 text-tpm-muted">{lifestylePage.sectionOne.body}</p>
      <h2 class="mt-10 text-2xl font-bold">{lifestylePage.sectionTwo.title}</h2>
      <p class="mt-4 text-tpm-muted">{lifestylePage.sectionTwo.body}</p>
      <h2 class="mt-10 text-2xl font-bold">{lifestylePage.sectionThree.title}</h2>
      <p class="mt-4 text-tpm-muted">{lifestylePage.sectionThree.body}</p>
    </div>
  </section>

  <blockquote class="eldcare-section max-w-2xl border-l-4 border-tpm-green pl-6 italic text-tpm-ink">
    {lifestylePage.testimonial.quote}
    <footer class="mt-3 not-italic text-sm text-tpm-muted">
      — {lifestylePage.testimonial.name}, {lifestylePage.testimonial.role}
    </footer>
  </blockquote>
</BaseLayout>