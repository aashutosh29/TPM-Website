---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/live/PageHero.astro';
import { livingOptionsPage } from '../data/pages/living-options';
import { site } from '../data/site';
---

<BaseLayout title={livingOptionsPage.metaTitle}>
  <PageHero title={livingOptionsPage.h1} />
  <section class="eldcare-section">
    <p class="text-sm font-semibold uppercase text-tpm-muted">{livingOptionsPage.tag}</p>
    <p class="mt-2 max-w-3xl text-lg text-tpm-muted">{livingOptionsPage.intro}</p>
    <div class="mt-10 space-y-10">
      {livingOptionsPage.suites.map((suite) => (
        <article class="grid gap-6 rounded-2xl border border-black/10 bg-white p-6 lg:grid-cols-2">
          <img src={suite.image} alt="" class="h-72 w-full rounded-xl object-cover" loading="lazy" />
          <div>
            <p class="text-sm font-semibold text-tpm-green">{suite.tag}</p>
            <h2 class="mt-1 text-2xl font-bold">{suite.name}</h2>
            <p class="mt-3 text-tpm-muted">{suite.description}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-tpm-green">{suite.cta}</span>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="border-t border-black/10 bg-tpm-green/5 py-14 text-center">
    <p class="text-sm font-semibold uppercase text-tpm-muted">{livingOptionsPage.cta.tag}</p>
    <h2 class="mt-2 text-2xl font-bold">{livingOptionsPage.cta.title}</h2>
    <p class="text-tpm-muted">{livingOptionsPage.cta.sub}</p>
    <p class="mt-6">
      <a href={`tel:${site.phoneTel}`} class="text-3xl font-bold text-tpm-green">{livingOptionsPage.cta.phone}</a>
    </p>
    <p class="mt-2">
      <a href={`mailto:${site.email}`} class="font-semibold text-tpm-green">{livingOptionsPage.cta.emailLabel}</a>
    </p>
  </section>
</BaseLayout>