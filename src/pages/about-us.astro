---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/live/PageHero.astro';
import { aboutPage } from '../data/pages/about-us';
import { site } from '../data/site';
---

<BaseLayout title={aboutPage.metaTitle}>
  <PageHero title={aboutPage.h1} />
  <section class="eldcare-section">
    <p class="text-sm font-semibold uppercase text-tpm-muted">{aboutPage.welcome}</p>
    <h2 class="mt-2 text-3xl font-bold md:text-4xl">
      {aboutPage.heroHeadline.plain}
      <span class="eldcare-highlight">{aboutPage.heroHeadline.highlight}</span>
    </h2>
    <p class="mt-4 max-w-3xl text-lg text-tpm-muted">{aboutPage.intro}</p>
    <img src={aboutPage.heroImage} alt="" class="mt-8 w-full rounded-2xl object-cover" loading="lazy" />
  </section>

  <section class="border-y border-black/10 bg-white">
    <div class="eldcare-section grid gap-6 md:grid-cols-3">
      {aboutPage.pillars.map((p) => (
        <article class="eldcare-feature-card">
          <h3 class="font-semibold text-tpm-green">{p.title}</h3>
          <p class="mt-2 text-sm text-tpm-muted">{p.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="eldcare-section">
    <p class="text-sm font-semibold uppercase text-tpm-muted">{aboutPage.valuesHeading}</p>
    <h2 class="mt-2 text-3xl font-bold">{aboutPage.differentHeading}</h2>
    <p class="text-tpm-muted">{aboutPage.differentSub}</p>
    <div class="mt-8 space-y-10">
      {aboutPage.showcase.map((item) => (
        <article class="grid gap-6 rounded-2xl border border-black/10 bg-white p-6 lg:grid-cols-2">
          <img src={item.image} alt="" class="h-64 w-full rounded-xl object-cover lg:h-full" loading="lazy" />
          <div>
            <p class="text-sm font-bold text-tpm-gold">{item.index}</p>
            <h3 class="mt-2 text-2xl font-bold">{item.title}</h3>
            <p class="mt-3 font-medium">{item.caption}</p>
            <p class="mt-2 text-tpm-muted">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-black/10 bg-tpm-green/5 py-14 text-center">
    <h2 class="text-2xl font-bold">{aboutPage.cta.title}</h2>
    <p class="mt-2 text-tpm-muted">{aboutPage.cta.sub}</p>
    <p class="mt-6">
      <a href={`tel:${site.phoneTel}`} class="text-3xl font-bold text-tpm-green">{aboutPage.cta.phone}</a>
    </p>
    <p class="mt-2">
      <a href={`mailto:${site.email}`} class="font-semibold text-tpm-green">{aboutPage.cta.emailLabel}</a>
    </p>
  </section>
</BaseLayout>