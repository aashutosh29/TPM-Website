---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/live/PageHero.astro';
import { familyPortalPage } from '../data/pages/family-portal';
---

<BaseLayout title={familyPortalPage.metaTitle}>
  <PageHero title={familyPortalPage.h1} />
  <section class="eldcare-section">
    <h2 class="text-2xl font-bold">{familyPortalPage.welcomeTitle}</h2>
    <p class="mt-4 max-w-2xl text-tpm-muted">{familyPortalPage.welcomeBody}</p>
    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <form class="wpcf7-form rounded-2xl border border-black/10 bg-white p-6" onsubmit="return false">
        <h3 class="text-lg font-semibold">Login</h3>
        <p class="mt-4">
          <label>Email</label>
          <input type="email" name="email" placeholder="Email" />
        </p>
        <p>
          <label>Password</label>
          <input type="password" name="password" placeholder="Password" />
        </p>
        <label class="mt-2 flex items-center gap-2 text-sm">
          <input type="checkbox" name="remember" />
          Remember Me
        </label>
        <button type="button" class="eldcare-btn mt-4">Login</button>
      </form>
      <form class="wpcf7-form rounded-2xl border border-black/10 bg-white p-6" onsubmit="return false">
        <h3 class="text-lg font-semibold">Sign Up</h3>
        <p class="mt-4">
          <label>Full Name</label>
          <input type="text" name="name" />
        </p>
        <p>
          <label>Email</label>
          <input type="email" name="email" />
        </p>
        <p>
          <label>Password</label>
          <input type="password" name="password" />
        </p>
        <p>
          <label>Select Resident</label>
          <select name="resident">
            <option value="">-- Choose Resident --</option>
            <option>Jake Redekopp</option>
            <option>Dave &amp; Mary McCready</option>
          </select>
        </p>
        <button type="button" class="eldcare-btn mt-4">Sign Up</button>
      </form>
    </div>
  </section>
</BaseLayout>