---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/live/PageHero.astro';
import { teamPage } from '../data/pages/our-team';
---

<BaseLayout title={teamPage.metaTitle}>
  <PageHero title={teamPage.h1} />
  <section class="eldcare-section text-center">
    <p class="text-sm font-semibold uppercase text-tpm-muted">{teamPage.tag}</p>
    <h2 class="mt-2 text-2xl font-bold">{teamPage.sub}</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-2">
      {teamPage.members.map((m) => (
        <article class="overflow-hidden rounded-2xl bg-white shadow-sm">
          <img src={m.image} alt="" class="h-80 w-full object-cover" loading="lazy" />
          <div class="p-6">
            <h3 class="text-xl font-bold">{m.name}</h3>
            <p class="text-tpm-green">{m.role}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="mt-10 text-tpm-muted">{teamPage.closing}</p>
    <a href="/living-options/" class="eldcare-btn mt-6">{teamPage.cta}</a>
  </section>
</BaseLayout>