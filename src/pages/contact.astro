---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/live/PageHero.astro';
import { contactPage } from '../data/pages/contact';
---

<BaseLayout title={contactPage.metaTitle}>
  <PageHero title={contactPage.h1} />
  <section class="eldcare-section grid gap-10 lg:grid-cols-2">
    <div>
      <h2 class="text-2xl font-bold">{contactPage.heading}</h2>
      <p class="mt-4 text-tpm-muted">{contactPage.intro}</p>
    </div>
    <div class="wpcf7-not-found">
      <p>
        <strong>Error:</strong> Contact form not found.
      </p>
    </div>
  </section>
</BaseLayout>