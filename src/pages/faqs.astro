---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const faqs = [
  {
    q: 'What is the cost of living at Tiverton Park Manor?',
    a: `Monthly costs depend on the suite type and level of care you choose. Many services are included in your monthly fee, which makes budgeting simpler for residents and families. Contact us at ${site.phone} or ${site.email} for current availability and a personalized quote — we are happy to walk through what is included.`,
  },
  {
    q: 'What is the age requirement?',
    a: 'Most residents are seniors who are ready for retirement living with support available when needed. We welcome conversations with families about timing and fit — every situation is unique, and we can help you understand whether now is the right step.',
  },
  {
    q: "What's the difference between suite types and care levels?",
    a: 'Suite types (single, studio, private, couple, and two-room layouts) describe your living space. Care and services are matched to each resident’s needs, from independent living with amenities to higher levels of nursing support. Our team will help you choose a suite and care plan that work together.',
  },
  {
    q: 'What services does Tiverton Park Manor provide?',
    a: 'We offer 24/7 staffing, nursing support, medication administration, nutritious meals, housekeeping, laundry, social and recreational programming, and coordination with healthcare providers. Therapy and additional services can be arranged based on individual care plans.',
  },
  {
    q: 'Is Tiverton Park Manor right for you or your loved one?',
    a: 'If you are looking for a warm, lakeside community with professional care and an active social life, we invite you to visit. Schedule a tour, meet our team, and see the residence for yourself — that is the best way to know if it feels like home.',
  },
];
---

<BaseLayout
  title="FAQs"
  description="Frequently asked questions about living at Tiverton Park Manor."
>
  <section class="bg-tpm-navy py-14 text-white">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="font-serif text-4xl">Frequently Asked Questions</h1>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-14">
    <div class="space-y-6">
      {
        faqs.map((item) => (
          <details class="group rounded-xl border border-slate-200 bg-white p-5 open:shadow-sm">
            <summary class="cursor-pointer list-none font-semibold text-tpm-navy group-open:text-tpm-teal">
              {item.q}
            </summary>
            <p class="mt-3 text-slate-600">{item.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-10 text-center text-slate-600">
      Still have questions?
      <a href="/contact" class="font-semibold text-tpm-teal hover:underline">Contact us</a>
      or
      <a href="/schedule-a-tour" class="font-semibold text-tpm-teal hover:underline">book a tour</a>.
    </p>
  </section>
</BaseLayout>