---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactStrip from '../components/ContactStrip.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  showContactStrip?: boolean;
}

const {
  title,
  description = site.tagline,
  showContactStrip = true,
} = Astro.props;

const pageTitle = title.includes('Tiverton Park Manor')
  ? title
  : `${title} | ${site.name}`;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#organization`,
  name: site.name,
  description: site.tagline,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  image: site.logoUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    postalCode: site.address.postal,
    addressCountry: site.address.country,
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Huron County, Ontario',
  },
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, site.url).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Parkinsans:wght@300..800&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    {showContactStrip && <ContactStrip />}
    <Footer />
  </body>
</html>